---
/**
 * Dev-only live preview. Injected by `cmsPreview()` — it is not a `pages/`
 * route, so production builds emit nothing here.
 *
 * Rendered on demand (prerender: false) and always read from disk. A
 * getStaticPaths snapshot is what made the CMS iframe ignore saves.
 */
import { readPost, readProject, type LoadedPost, type LoadedProject } from '@codeblin/content';

import BlockRenderer from '~/blocks/BlockRenderer.astro';
import Base from '~/layouts/Base.astro';

const kind = Astro.params.kind;
const slug = Astro.params.slug;

if (kind !== 'posts' && kind !== 'projects') {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
if (!slug) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

let post: LoadedPost | undefined;
let project: LoadedProject | undefined;

try {
  if (kind === 'posts') post = readPost(slug, { fresh: true });
  else project = readProject(slug, { fresh: true });
} catch {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate');

const title = kind === 'posts' ? (post?.frontmatter.title ?? 'Draft') : (project?.frontmatter.name ?? 'Draft');
const blocks = kind === 'posts' ? (post?.blocks ?? []) : (project?.blocks ?? []);
---

<Base title={`Preview · ${title}`} description="Local draft preview. Not indexed." noindex>
  <p class="shell preview-banner label">
    <span class="preview-banner__slash" aria-hidden="true">/</span>
    LOCAL PREVIEW — NOT PUBLISHED
  </p>
  <article class="shell preview-body">
    <h1 class="display preview-title">{title}</h1>
    <BlockRenderer blocks={blocks} kind={kind} slug={slug} />
  </article>
</Base>

<style>
  .preview-banner {
    padding-block: var(--s-4);
    color: var(--sulfur);
    border-block-end: var(--bw) solid var(--hair);
  }

  .preview-banner__slash {
    color: var(--sulfur);
  }

  .preview-title {
    font-size: var(--fs-display-3);
    color: var(--bone);
    margin-block: var(--s-8) var(--s-6);
  }

  .preview-body {
    max-inline-size: var(--measure);
    padding-block-end: var(--s-24);
  }
</style>
