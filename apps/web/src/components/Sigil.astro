---
/**
 * House mark: an open C. Hairline only — the initial, not a star, not a kit icon.
 */
interface Props {
  size?: string;
  /** One-shot stroke draw. Homepage field only — never in sticky chrome. */
  motion?: boolean;
}

const { size = '16px', motion = false } = Astro.props;
---

<svg
  class="sigil"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  data-motion={motion ? '' : undefined}
>
  <path
    class="sigil__c"
    d="M16.3 5.86 A 7.5 7.5 0 1 0 16.3 18.14"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="square"
    pathLength="1"
  />
</svg>

<style>
  .sigil {
    position: relative;
    z-index: 1;
    display: block;
    flex-shrink: 0;
    color: var(--sulfur);
  }

  .sigil[data-motion] .sigil__c {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    animation: cb-draw-stroke var(--dur-6) var(--ease-enter) both;
  }
</style>
