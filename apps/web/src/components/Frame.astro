---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { resolveImage, type RecordKind } from '~/lib/media.ts';

interface Props {
  kind: RecordKind;
  slug: string;
  src: string;
  alt: string;
  duotone?: boolean;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  kind,
  slug,
  src,
  alt,
  duotone = true,
  widths = [480, 800, 1200, 1600],
  sizes = '(min-width: 60rem) 60rem, 100vw',
  loading = 'lazy',
  class: className,
} = Astro.props;

const resolved = resolveImage(kind, slug, src);
---

{
  resolved && (
    <div
      class:list={['frame', className]}
      data-duotone={duotone ? '' : undefined}
    >
      {resolved.optimisable ? (
        <Image
          src={resolved.source as ImageMetadata}
          alt={alt}
          widths={widths}
          sizes={sizes}
          loading={loading}
          decoding="async"
          format="avif"
        />
      ) : (
        <img src={resolved.source as string} alt={alt} loading={loading} decoding="async" />
      )}
      <span class="frame__corner" aria-hidden="true" />
    </div>
  )
}

<style>
  /**
   * Screenshots sit in a hairline frame. A dark veil tints them into the
   * palette without `filter` or `mix-blend-mode` — both of those re-composite
   * the bitmap on every scroll frame. Hover lifts the veil so the evidence
   * is one gesture away.
   */
  .frame {
    position: relative;
    overflow: hidden;
    border: var(--bw) solid var(--hair);
    background: var(--slate);
  }

  .frame :global(img) {
    inline-size: 100%;
    display: block;
  }

  .frame[data-duotone]::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--void);
    opacity: 0.38;
    pointer-events: none;
  }

  /* A single inset corner mark, echoing the bracket language without the
     full four-corner treatment reserved for interactive surfaces. */
  .frame__corner {
    position: absolute;
    inset-block-start: 8px;
    inset-inline-start: 8px;
    inline-size: 10px;
    block-size: 10px;
    border-block-start: 1px solid var(--sulfur);
    border-inline-start: 1px solid var(--sulfur);
    opacity: 0.55;
    pointer-events: none;
  }
</style>
