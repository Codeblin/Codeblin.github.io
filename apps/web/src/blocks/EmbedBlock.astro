---
import type { Block } from '@codeblin/content';

import YoutubeEmbed from './YoutubeEmbed.astro';

interface Props {
  block: Extract<Block, { type: 'embed' }>;
}

const { block } = Astro.props;

const gistHref = `https://gist.github.com/${block.ref}`;
---

{
  block.provider === 'youtube' ? (
    <figure class="embed-video">
      <YoutubeEmbed id={block.ref} caption={block.title} />
      {block.title && <figcaption class="embed-video__caption label">{block.title}</figcaption>}
    </figure>
  ) : (
    <a class="embed bracketed" href={gistHref} rel="noopener noreferrer" target="_blank">
      <span class="embed__provider micro">GIST</span>
      <span class="embed__title">{block.title ?? gistHref}</span>
      <span class="embed__note micro">Opens on gist.github.com ↗</span>
    </a>
  )
}

<style>
  .embed-video__caption {
    margin-block-start: var(--s-3);
    color: var(--dust);
    line-height: 1.6;
  }

  .embed {
    display: grid;
    gap: var(--s-2);
    padding: var(--s-4) var(--s-5);
    border: var(--bw) solid var(--hair);
    background: var(--tar);
    text-decoration: none;
  }

  .embed:hover,
  .embed:focus-visible {
    border-color: var(--hair-lit);
  }

  .embed__provider {
    color: var(--sulfur);
  }

  .embed__title {
    color: var(--bone);
    font-family: var(--font-display);
    font-weight: var(--w-semibold);
    font-size: var(--fs-h3);
    line-height: var(--lh-heading);
  }

  .embed__note {
    color: var(--dust);
  }
</style>
