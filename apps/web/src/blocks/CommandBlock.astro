---
import type { Block } from '@codeblin/content';
import CopyButton from '~/components/CopyButton.astro';

interface Props {
  block: Extract<Block, { type: 'command' }>;
}

const { block } = Astro.props;
const sourceId = `command-${block.id}`;
---

<div class="command">
  <div class="command__line">
    <span class="command__prompt" aria-hidden="true">$</span>
    <code class="command__value" id={sourceId}>{block.value}</code>
    <CopyButton target={sourceId} label="Copy command" />
  </div>
  {block.note && <p class="command__note micro">{block.note}</p>}
</div>

<style>
  /*
   * A single command a reader is meant to run, as opposed to a transcript of
   * commands already run. One line, one copy target.
   */
  .command {
    border: var(--bw) solid var(--hair);
    background: var(--slate);
    border-inline-start: 2px solid var(--sulfur);
  }

  .command__line {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
  }

  .command__prompt {
    color: var(--sulfur);
    font-family: var(--font-code);
    font-size: var(--fs-code);
    flex: none;
  }

  .command__value {
    flex: 1;
    min-inline-size: 0;
    color: var(--bone);
    overflow-x: auto;
    white-space: pre;
    scrollbar-width: none;
  }

  .command__note {
    padding: var(--s-2) var(--s-4) var(--s-3);
    border-block-start: var(--bw) solid var(--hair);
    color: var(--dust);
    text-transform: none;
    letter-spacing: 0.04em;
    line-height: 1.6;
  }
</style>
